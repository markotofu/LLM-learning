# Dependencies (none are required)
node_modules/
package-lock.json

# Python / test artefacts
__pycache__/
*.pyc
tests/.tmp/

# Browser test output (Playwright)
test-results/
playwright-report/
tests/e2e/.baseline/

# Logs & temp
*.log
*.tmp

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Personal exports from the app
ml-atlas-progress-*.json
ml-atlas-code-*.py

# Local dev tooling
.claude/

